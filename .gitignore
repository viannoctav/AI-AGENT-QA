# ============================================================
# File & folder yang TIDAK dinaikkan ke GitHub
# ============================================================

# --- Rahasia (API key, token, password) ---
.env
.env.*

# --- Lingkungan Python (dibuat otomatis oleh Jalankan_Tera.bat) ---
.venv/
venv/
__pycache__/
*.pyc

# --- Editor ---
.vs/
.vscode/

# --- Hasil kerja di laptop masing-masing (dibuat ulang setiap proses) ---
runs/
outputs/
knowledge/cache/

# --- Basis data vektor lama (dibuat ulang otomatis, ukurannya besar) ---
vector_store/
knowledge/vector_db/

# --- Data kantor (jangan dipublikasikan) ---
# Contoh test case perusahaan: dipakai AI sebagai acuan gaya penulisan.
# Hapus baris di bawah HANYA jika repo privat dan memang boleh dibagikan.
# PRD hasil konversi catatan QA kantor
knowledge/prd/*_dari_catatan*.md
knowledge/prd/*_dari_desain*.md

# --- File sementara Excel/Word yang sedang terbuka ---
~$*

# --- File sementara Windows ---
Thumbs.db
desktop.ini

# --- Catatan pemasang sekali klik ---
pasang_tera.log

# --- Server AI bersama: akun, sesi login, dan catatan pemakaian (rahasia) ---
data/server_ai/
# --- Token login ke Server AI bersama di laptop ini (rahasia) ---
configs/sumber_ai.json
configs/sumber_ai.tmp

# --- Server AI bersama dan halaman admin akun: hanya untuk pemilik server, tidak dibagikan lewat GitHub ---
Server_AI_dan_Admin_Akun.bat
Jalankan_Server_AI.bat
ai_server/
# --- Referensi test case perusahaan: yang naik ke GitHub hanya versi terkunci (*.terakunci + kunci.json) ---
knowledge/company_testcases/*.xlsx
configs/kunci_referensi.json
configs/kunci_referensi.tmp
# --- Riwayat MD ke PDF dan perbandingan test case (hasil kerja), cadangan sebelum pembaruan ---
outputs/md_pdf/
outputs/tc_compare/
data/cadangan_update/
